{
  "protocolVersion": 1,
  "id": "free-token",
  "name": "Free Token Gateway",
  "category": "llm",
  "tier": "recommended",
  "description": "Curated free/trial LLM catalog, key connections, and local rotation gateway for DSH/OpenCode. Upstream keys stay in the gateway home; stopping restores original Agent model settings.",
  "source": {
    "github": "https://github.com/youcizi-art/cizhenyu_free_token",
    "defaultRef": "master"
  },
  "install": {
    "runtime": "node",
    "steps": [],
    "readyCheck": ["server.mjs", "manage.mjs", "mcp_launcher.mjs"]
  },
  "config": {
    "type": "page",
    "url": "http://127.0.0.1:20188/",
    "requireService": true
  },
  "env": [
    { "name": "CIZHENYU_AUTH_DIR", "from": "credentialsDir" }
  ],
  "mcp": {
    "transport": "stdio",
    "command": "node",
    "args": ["mcp_launcher.mjs"],
    "cwd": "."
  },
  "guides": {
    "setup": "guides/setup.md",
    "setupByLocale": {
      "zh-CN": "guides/setup.md",
      "zh": "guides/setup.md",
      "en": "guides/setup.en.md",
      "en-US": "guides/setup.en.md"
    }
  },
  "health": {
    "requireCredentials": false,
    "requireReadyFiles": ["server.mjs", "manage.mjs"]
  },
  "actions": [],
  "defaultLocale": "en",
  "i18n": {
    "zh-CN": {
      "description": "策展免费/试用商家目录、回填密钥、本机轮换网关，供 DSH/OpenCode 使用。上游 Key 只保存在网关 home；关闭服务后恢复 Agent 原模型配置。"
    }
  }
}
